  "preconfiguredEntries": [
    {
      "groupId": "5c03119e-3074-46fd-976b-c60198311f70",
      "group": {
        "default": "Advanced"
      },
      "title": {
        "default": "SharePoint Permission Visualizer"
      },
      "description": {
